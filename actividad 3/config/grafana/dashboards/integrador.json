{
  "uid": "actividad3-integrador",
  "title": "Actividad 3 - Observabilidad end-to-end",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Solicitudes / s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(lab_requests_total[30s]))",
          "refId": "A",
          "legendFormat": "{{service}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Errores HTTP 5xx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(lab_requests_total{status=~\"5..\"}[30s]))",
          "refId": "A",
          "legendFormat": "{{service}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Latencia p99 por servicio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(lab_duration_seconds_bucket[30s])))",
          "refId": "A",
          "legendFormat": "{{service}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "AIOps: error rate vs baseline + 2 sigma",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "aiops_error_rate",
          "refId": "A",
          "legendFormat": "{{service}} {{__name__}}"
        },
        {
          "expr": "aiops_baseline_threshold",
          "refId": "B",
          "legendFormat": "{{service}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Golden Signals: autenticacion fallida",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(lab_auth_failures_total[30s]))",
          "refId": "A",
          "legendFormat": "{{service}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Golden Signals: trafico E-W Envoy",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(envoy_http_downstream_rq_total[30s]))",
          "refId": "A",
          "legendFormat": "{{service}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Alerta correlacionada",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "aiops_correlated_anomaly",
          "refId": "A",
          "legendFormat": "{{service}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Ventanas estaticas vs correlacionadas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "aiops_static_windows_total",
          "refId": "A",
          "legendFormat": "{{service}} {{__name__}}"
        },
        {
          "expr": "aiops_correlated_windows_total",
          "refId": "B",
          "legendFormat": "{{service}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Seguridad: vulnerabilidades conocidas (instantanea)",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**7 identificadores unicos de vulnerabilidad** en dependencias Python. Instantanea de pip-audit; no es escaneo de imagen ni Security Hub/SCC. Ver `evidencias/security-scan.json`. Prioridad: actualizar FastAPI/Starlette y repetir las pruebas."
      }
    }
  ]
}